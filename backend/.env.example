# Copy to .env and fill in. Validated by config/env.js at boot.

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

PORT=5000
NODE_ENV=development

# Free-tier alias: fastest free model with the highest free quota.
# Do NOT change this to a Pro model — those are paid-tier only.
GEMINI_MODEL=gemini-flash-lite-latest

# Comma-separated browser origins allowed to call this API.
# Add your Netlify URL in production, e.g.
# CORS_ORIGIN=http://localhost:5173,https://your-site.netlify.app
CORS_ORIGIN=http://localhost:5173

# ---- Database (RBAC/SaaS layer) ----------------------------------------
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# ---- Auth -----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Platform owner (static — not a database row, checked directly against
#      these two values in authController.login; no seeding needed) --------
SUPER_ADMIN_EMAIL=super.dibyendu@yopmail.com
SUPER_ADMIN_PASSWORD=superdibyendu@123

# ---- Email (credential delivery) ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=mCOM <no-reply@mcom.local>

FRONTEND_URL=http://localhost:5173
