# Copy to .env and fill in. Validated by config/env.js at boot.

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

PORT=5000
NODE_ENV=development

# Free-tier alias: fastest free model with the highest free quota.
# Do NOT change this to a Pro model — those are paid-tier only.
GEMINI_MODEL=gemini-flash-lite-latest

# Comma-separated browser origins allowed to call this API.
# Add your Netlify URL in production, e.g.
# CORS_ORIGIN=http://localhost:5173,https://your-site.netlify.app
CORS_ORIGIN=http://localhost:5173

# Database. "memory" runs a zero-setup in-process MongoDB (data resets on
# restart, auto-seeded) — great for local demos. Use a real URI to persist:
#   MONGO_URI=mongodb://127.0.0.1:27017/mcom
#   MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mcom
MONGO_URI=memory

# Auth. MUST be a long random string in production (boot fails otherwise).
JWT_SECRET=dev-only-insecure-change-me
JWT_EXPIRES=7d

# First super admin, created by the seed script on first boot.
SUPERADMIN_EMAIL=super@mcom.dev
SUPERADMIN_PASSWORD=super1234
